# Copy to .env — NEVER commit real secrets.
PORT=5000
NODE_ENV=development
# MongoDB Atlas: create cluster at https://cloud.mongodb.com -> Database Access (user) -> Network Access -> Connect (Drivers) SRV URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/school-erp?retryWrites=true&w=majority
JWT_ACCESS_SECRET=change-me-long-random-string
JWT_REFRESH_SECRET=change-me-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# First-admin seed (npm run seed:admin) — set these ONLY when seeding, use a strong password, then remove or keep private. The seed script refuses to run without them and never prints the password.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Future integrations (leave blank until configured — features stay disabled, not faked)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Online payments (Phase 7 — structure only until ALL FOUR are set and a real
# provider adapter is implemented in backend/src/modules/payments/payment-provider.ts).
# While any of these is blank: POST /payments/online/checkout returns
# 503 PAYMENT_GATEWAY_NOT_CONFIGURED and the webhook endpoint rejects every
# delivery — nothing is ever marked paid by an unconfigured path.
#   PAYMENT_PROVIDER        provider name, e.g. stripe (selects the adapter)
#   PAYMENT_GATEWAY_KEY     provider API/publishable key
#   PAYMENT_GATEWAY_SECRET  provider SECRET key (backend only, never frontend)
#   PAYMENT_WEBHOOK_SECRET  webhook signing secret (signature verification)
PAYMENT_PROVIDER=
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
PAYMENT_WEBHOOK_SECRET=
# External notification channels (Phase 9 — structure only, same pattern as
# payments: in-app notifications + Socket.IO always work; email/SMS/WhatsApp
# dispatch is an explicit NO-OP until a channel's variables are ALL set AND a
# real adapter is implemented in backend/src/modules/notifications/channels.ts.
# A send is never faked and nothing is ever marked "sent" while unconfigured.)
#   Email (SMTP):    SMTP_HOST, SMTP_USER, SMTP_PASSWORD (nodemailer-style SMTP settings)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
#   SMS provider:    SMS_PROVIDER (e.g. twilio), SMS_API_KEY (+ provider-specific vars the adapter needs)
SMS_PROVIDER=
SMS_API_KEY=
#   WhatsApp:        WHATSAPP_PROVIDER (e.g. twilio), WHATSAPP_API_KEY
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
